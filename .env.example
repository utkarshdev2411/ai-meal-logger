# CalorAI meal-logging agent — example environment.
# Copy to .env and fill in LLM_API_KEY. Everything else has a working default.
#   cp .env.example .env
# These values (plus a real key) are all the app needs to boot.

# ---------------------------------------------------------------------------
# Provider
# ---------------------------------------------------------------------------

# Any OpenAI-compatible endpoint. Default is OpenRouter, which gives access to
# every model role below through one key. Point this at Groq / Together /
# Gemini's compat layer / a local vLLM and nothing else has to change.
LLM_BASE_URL=https://openrouter.ai/api/v1

# Required. Never commit a real key — .env is gitignored, .env.example is not.
LLM_API_KEY=REPLACE_ME

# ---------------------------------------------------------------------------
# Model roles — three distinct models, never one model for everything.
#
# WARNING: the free-tier IDs below carry a ":free" suffix and were checked
# against the provider's live model list on 2026-09-01. Free-tier model IDs on
# OpenRouter are renamed, retired and rate-limited without notice, so these
# defaults WILL rot — treat them as unverified. Run
# `python scripts/check_models.py` before any demo; it pings all three roles
# and tells you which one has gone away. Swap in a paid ID (drop the ":free")
# for a stable demo.
# ---------------------------------------------------------------------------

# Conversational agent. The only role that does tool calling, so it needs
# reliable function-call support; trades a little quality for latency, since
# every turn pays for it twice.
TEXT_MODEL=z-ai/glm-5.2:free

# Image -> structured food observation. Must be genuinely multimodal; never
# asked to converse, so raw chat quality matters less than portion/ingredient
# recognition. Kept separate from TEXT_MODEL on purpose.
VISION_MODEL=google/gemma-4-31b-it:free

# Background memory-fact extraction. Runs after the reply has streamed, so it
# is off the critical path — pick the cheapest/fastest model that can emit
# valid structured output.
EXTRACTOR_MODEL=liquid/lfm-2.5-2.6b:free

# ---------------------------------------------------------------------------
# Persistence
# ---------------------------------------------------------------------------

# SQLite keeps a clean clone at zero setup and contributes ~0 ms to latency, so
# demo numbers show model time honestly. Swap for a hosted Postgres to see the
# real network cost: postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///./calorai.db

# ---------------------------------------------------------------------------
# Latency / quality knobs
# ---------------------------------------------------------------------------

# Hard cap on reply length. Decode is ~15-40 ms/token, so this is the single
# biggest latency knob after the number of LLM round trips — and it pulls the
# same direction as quality, because a friend texting you writes two sentences.
REPLY_MAX_TOKENS=80

# How many durable facts may enter the prompt per turn. Higher = better recall,
# more prefill on every single turn.
MEMORY_TOP_K=8

# Hard ceiling on the rendered memory block. Guarantees the prompt cannot grow
# with the user's fact count, no matter how many facts accumulate.
MEMORY_TOKEN_BUDGET=300

# Conversation turns kept in context. Enough for a correction to refer back;
# short enough that a long thread doesn't inflate every prompt.
HISTORY_TURNS=6

# Long-edge pixels the image is downscaled to before upload. Dominates image
# upload time and vision prefill; below ~768 px plate recognition starts to
# degrade, above it you pay for detail the model doesn't use.
IMAGE_MAX_EDGE=768

# Experimental single-call mode for log/correct intents: the model emits reply
# and action in one structured response instead of two round trips. Faster,
# riskier. Off by default; the two-call path is the shipped default.
FAST_PATH=false

# ---------------------------------------------------------------------------
# Tracing (optional)
# ---------------------------------------------------------------------------

# Turn on to send traces to LangSmith. Adds an external dependency to every
# turn's teardown, so it stays off unless you are debugging or demoing traces.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=calorai-meal-logger
